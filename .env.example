# Copy to .env and fill in real values.
# Never commit .env to git.

# SQLite database path inside the container
DB_URL=jdbc:sqlite:/var/lib/nquiz-ai-service/data/nquiz-ai-service.db

# LLM provider credentials (set only the providers you use)
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Payment webhook secret (Stripe webhook signing secret)
# Leave empty to skip signature verification (dev only)
PAYMENT_WEBHOOK_SECRET=

# API client defaults (optional, used by scripts/api_client.py)
# NQUIZ_BASE_URL=http://localhost:8080
# NQUIZ_USER_TOKEN=
# NQUIZ_ADMIN_TOKEN=

# Production image override (optional, used by docker-compose.prod.yml)
# IMAGE=ghcr.io/your-org/nquiz-ai-service:latest
