# Copy to application-prod.yml on the VPS (this file is safe to commit as a template).
# Real secrets belong in /opt/nquiz-ai-service/.env, not in this file.

micronaut:
  application:
    name: nquiz-ai-service
  server:
    forwarded-header-strategy: NATIVE

# Reverse proxies whose X-Real-IP / X-Forwarded-For are trusted (comma-separated IPs/CIDRs).
# Not set -> loopback + private ranges (fits Nginx/Caddy on the same host or a Docker bridge).
# Set it only if the proxy comes from elsewhere; the list replaces the default.
#app:
#  trusted-proxies: "127.0.0.0/8,::1/128,172.16.0.0/12"

datasources:
  default:
    url: jdbc:sqlite:/var/lib/nquiz-ai-service/data/nquiz-ai-users.db?journal_mode=WAL
    driver-class-name: org.sqlite.JDBC
    pooled: false
    connectionProperties:
      synchronous: NORMAL

flyway:
  enabled: true
  locations:
    - classpath:db/migration

logger:
  levels:
    com.lainlab: INFO
    root: WARN

endpoints:
  health:
    enabled: true
    sensitive: false
    details-visible: AUTHENTICATED
